{
  "expo": {
    "name": "Budget",
    "slug": "budget",
    "scheme": "realbudget",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "bundleIdentifier": "com.realbudget.app",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Budget uses the microphone so you can speak your spending instead of typing it. Recordings are transcribed and then deleted, never stored."
      }
    },
    "android": {
      "package": "com.realbudget.app",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3B2A21"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon-light.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F6F3EF",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#14110E"
          }
        }
      ],
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Budget to use the camera to scan receipts."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Budget to access your photos to attach receipts to expenses."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Budget to use Face ID to unlock the app."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Budget to access your photos.",
          "savePhotosPermission": "Allow Budget to save receipts to your photos."
        }
      ],
      "./plugins/withFmtConstevalFix",
      "./plugins/withAppIntents",
      "./plugins/withShareExtension",
      "./plugins/withAppShortcutLocalization",
      "expo-localization",
      "expo-audio",
      "expo-asset",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      "./plugins/withIosDeploymentTarget"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "97dd0e8e-7c1e-4253-818c-703d222403b8"
      }
    },
    "owner": "symow",
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
