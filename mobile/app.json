{
  "expo": {
    "name": "Latchet",
    "slug": "latchet",
    "scheme": "latchet",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.latchet.app",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Latchet uses the microphone so you can speak your spending instead of typing it. Recordings are transcribed and then deleted, never stored."
      }
    },
    "android": {
      "package": "com.latchet.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3B2A21"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon-light.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F6F3EF",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#14110E"
          }
        }
      ],
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Latchet to use the camera to scan receipts."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Latchet to access your photos to attach receipts to expenses."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Latchet to use Face ID to unlock the app."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Latchet to access your photos.",
          "savePhotosPermission": "Allow Latchet to save receipts to your photos."
        }
      ],
      "./plugins/withAppIntents",
      "./plugins/withShareExtension",
      "./plugins/withAppShortcutLocalization",
      "expo-localization",
      "expo-audio",
      "expo-asset",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "./plugins/withIosDeploymentTarget",
      "@sentry/react-native",
      "./plugins/withSentryOptionalUpload",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-secure-store",
      "expo-sqlite",
      "expo-image",
      "expo-sharing",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0abaa473-bff7-4413-a390-178e7fbbe298"
      }
    },
    "owner": "symow",
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
