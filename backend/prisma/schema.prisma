generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      BankAccount[]
  authAccounts  Account[]
  transactions  Transaction[]
  settings      UserSettings?
  billReminders BillReminder[]
  recurringTransactions RecurringTransaction[]
  netWorthEntries NetWorthEntry[]
  categoryBudgets CategoryBudget[]
  ownedBusiness   Business?
  teamMemberships TeamMember[]
  submittedExpenses  Expense[] @relation("SubmittedExpenses")
  reviewedExpenses   Expense[] @relation("ReviewedExpenses")
  salaries           Salary[]
  achievements       Achievement[]
  pushTokens         PushToken[]
  plaidItems         PlaidItem[]
  emailConnections   EmailConnection[]
  inboxEmails        InboxEmail[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("AuthAccount")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model BankAccount {
  id           String        @id
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  type         String        // cash|checking|savings|credit|investment|other
  balance      Float         @default(0)
  currency     String        @default("USD")
  color        String        @default("#a855f7")
  icon         String        @default("wallet")
  isDefault    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
}

model Transaction {
  id          String      @id
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId   String?
  account     BankAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  amount      Float
  category    String      // Food|Gym|Transport|Shopping|Subscriptions|Other
  type        String      // Expense|Income
  isImpulse   Boolean     @default(false)
  note        String?
  dateISO     String      // YYYY-MM-DD
  currency    String      @default("USD")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId, dateISO])
}

model UserSettings {
  id             String  @id
  userId         String  @unique
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthlyBudget  Float   @default(0)
  startingBalance Float  @default(0)
  hourlyValue    Float   @default(0)
  showTimeCost   Boolean @default(false)
  currency       String  @default("USD")
  currencySymbol String  @default("$")
  monthlyIncome  Float   @default(0)
  savingsGoal    Float   @default(0)
  spendingStyle  String  @default("moderate")
  primaryGoal    String  @default("track")
  // Which business the user is currently acting in. Membership resolution used
  // findFirst, so a user in more than one business got a non-deterministic
  // answer that could change between requests.
  activeBusinessId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model BillReminder {
  id          String    @id
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  amount      Float
  dueDay      Int       // day of month (1-31)
  category    String    @default("Other")
  isRecurring Boolean   @default(true)
  isPaid      Boolean   @default(false)
  paidAt      DateTime?
  nextDueDate String    // YYYY-MM-DD
  // Last push sent for the *current* nextDueDate. Guards the 5-minute checker
  // against re-notifying a bill that has already fired for this due date —
  // non-recurring bills never advance nextDueDate, so without this they match
  // the due query on every tick forever.
  lastNotifiedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, nextDueDate])
}

model RecurringTransaction {
  id          String    @id
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId   String?
  name        String
  amount      Float
  category    String
  type        String    // Expense|Income
  isImpulse   Boolean   @default(false)
  frequency   String    // daily|weekly|biweekly|monthly|yearly
  startDate   String    // YYYY-MM-DD
  nextDate    String    // YYYY-MM-DD
  lastCreated String?   // YYYY-MM-DD
  isActive    Boolean   @default(true)
  currency    String    @default("USD")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([isActive, nextDate])
}

model NetWorthEntry {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String   // YYYY-MM-DD
  assets    Float    @default(0)
  liabilities Float  @default(0)
  netWorth  Float    @default(0)
  breakdown String?  // JSON string
  createdAt DateTime @default(now())
}

model CategoryBudget {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String
  amount    Float
  period    String   @default("monthly")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, category])
}

// Persisted gamification: a badge stays earned even after the underlying
// transactions change or the app is reinstalled. `badge` is the badge key
// (e.g. "7-Day Streak"); `bestStreak` tracks the user's all-time logging streak.
model Achievement {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge      String
  earnedAt   DateTime @default(now())
  bestStreak Int      @default(0)

  @@unique([userId, badge])
}

// Expo push tokens for delivering bill reminders, streak nudges, and
// badge-earned alerts. One row per device; token is unique.
model PushToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A linked Plaid Item (one per institution connection). The access token is
// stored encrypted at rest (AES-256-GCM, key derived from BETTER_AUTH_SECRET).
// `cursor` is Plaid's /transactions/sync pagination cursor for incremental pulls.
model PlaidItem {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId          String         @unique
  accessTokenEnc  String
  institutionId   String?
  institutionName String?
  cursor          String?
  status          String         @default("active") // active|error|disconnected
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  accounts        PlaidAccount[]
}

// An account exposed by a Plaid Item, mirrored locally for display + balances.
model PlaidAccount {
  id            String    @id @default(cuid())
  itemId        String
  item          PlaidItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  plaidAccountId String   @unique
  name          String
  type          String    // checking|savings|credit|investment|other
  mask          String?
  balance       Float     @default(0)
  currency      String    @default("USD")
  isEnabled     Boolean   @default(true)
  // The local BankAccount this Plaid account is mirrored into. Bank-synced
  // transactions are booked against it, so they affect a balance and can be
  // filtered by account like any hand-entered row.
  bankAccountId String?
  updatedAt     DateTime  @updatedAt
}

// A connected email inbox (Gmail today; provider-agnostic for Outlook/IMAP
// later). The OAuth refresh token is stored encrypted at rest (AES-256-GCM via
// lib/crypto.ts, key derived from BETTER_AUTH_SECRET) — same pattern as PlaidItem.
model EmailConnection {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        String    @default("gmail") // "gmail" (OAuth) | "forwarding" | future "outlook"
  email           String // the connected/owning inbox address
  refreshTokenEnc String? // OAuth refresh token (gmail); null for forwarding connections
  // Forwarding ("inbox inside Budget"): a unique token forms the user's private
  // inbound address  u_<inboundToken>@<INBOUND_EMAIL_DOMAIN>.  forwardingVerified
  // flips true once we receive Gmail's forwarding-confirmation email.
  inboundToken       String?  @unique
  forwardingVerified Boolean  @default(false)
  status          String    @default("active") // active | revoked
  lastScanAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, email])
}

// One parsed billing/receipt email received at a user's private inbound address.
// The raw email is parsed (OpenAI) into subscription fields and discarded; we
// keep only the extracted summary. The mobile app pulls these and merges them
// into the local subscription store + spending.
model InboxEmail {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromAddr    String
  subject     String
  merchant    String?
  amount      Float?
  currency    String   @default("USD")
  cadence     String   @default("unknown") // weekly | monthly | yearly | unknown
  chargedISO  String? // YYYY-MM-DD best-effort charge date
  isSubscription Boolean @default(false)
  status      String   @default("parsed") // parsed | imported | ignored
  receivedAt  DateTime @default(now())

  @@index([userId, receivedAt])
}

model Business {
  id          String          @id @default(cuid())
  ownerId     String          @unique
  name        String
  inviteCode  String?         @unique
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  owner       User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  teamMembers TeamMember[]
  expenses    Expense[]
  budget      BusinessBudget?
  salaries    Salary[]
}

model TeamMember {
  id         String   @id @default(cuid())
  businessId String
  userId     String
  role       String   // "owner" | "manager" | "employee"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
}

model Expense {
  id          String    @id @default(cuid())
  businessId  String
  submitterId String
  reviewerId  String?
  amount      Float
  category    String    // Travel|Software|Meals|Transport|Office|Other
  description String
  imageUrl    String?
  status      String    @default("pending") // pending|approved|rejected
  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  submitter   User      @relation("SubmittedExpenses", fields: [submitterId], references: [id], onDelete: Cascade)
  reviewer    User?     @relation("ReviewedExpenses", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([businessId, status])
  @@index([businessId, submittedAt])
}

model BusinessBudget {
  id             String   @id @default(cuid())
  businessId     String   @unique
  totalMonthly   Float    @default(0)
  categories     String?  // JSON: { "Travel": 500, "Meals": 200, ... }
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Salary {
  id         String          @id @default(cuid())
  businessId String
  userId     String
  amount     Float           // monthly salary amount
  currency   String          @default("USD")
  title      String?         // job title / role label
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  business   Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments   SalaryPayment[]

  @@unique([businessId, userId])
  @@index([businessId])
}

model SalaryPayment {
  id        String    @id @default(cuid())
  salaryId  String
  month     Int       // 1–12
  year      Int
  status    String    @default("unpaid") // "paid" | "unpaid"
  paidAt    DateTime?
  note      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  salary    Salary    @relation(fields: [salaryId], references: [id], onDelete: Cascade)

  @@unique([salaryId, month, year])
}
