generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Sync columns ────────────────────────────────────────────────────────────
// The nine tables the phone syncs (Transaction, BankAccount, UserSettings,
// CustomCategory, Subscription; since Phase 4 RecurringTransaction,
// BillReminder, CategoryBudget, NetWorthEntry) carry two timestamps:
//
//   clientUpdatedAt  When the change was made on a client (server-created rows
//                    use the server's time). Last writer wins by this value.
//   serverUpdatedAt  When the row last changed on THIS database, set by a
//                    trigger to clock_timestamp() (in UTC) on every insert and
//                    update. The pull cursor orders by it. Never written by the
//                    app: @updatedAt is each instance's own clock, and two
//                    instances' clocks cannot order one ledger.
//
// The triggers live in the init migration (prisma/migrations/*_postgres_init)
// and, for the Phase 4 tables, in *_phase4_offline_sync: serverUpdatedAt,
// BankAccount.balance derived from the ledger, and a SyncTombstone row for
// every delete of a synced row, however it happened.
//
// Server-side writes to a synced row (a REST route, the recurring job, the
// bill checker) set clientUpdatedAt from the database clock, so the server's
// change wins over an older phone copy (Phase 4 decision 4).

model User {
  id                    String                 @id
  name                  String
  email                 String                 @unique
  emailVerified         Boolean                @default(false)
  image                 String?
  /// "free" | "pro". Decided server-side from RevenueCat; never from the client.
  entitlement           String                 @default("free")
  /// When pro access lapses. Read on every check, so a missed EXPIRATION
  /// webhook cannot leave someone on pro indefinitely.
  entitlementExpiresAt  DateTime?
  /// RevenueCat's app_user_id. Equals `id` once the client calls setUserId,
  /// which is what lets a webhook find the account a purchase belongs to.
  revenueCatUserId      String?
  /// The IANA time zone the user's phone last reported (PUT /me/timezone).
  /// The server's "today" for this user — recurring bookings, bill reminders —
  /// is their local date in it (lib/user-day.ts); null means UTC.
  timezone              String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  sessions              Session[]
  accounts              BankAccount[]
  authAccounts          Account[]
  transactions          Transaction[]
  settings              UserSettings?
  billReminders         BillReminder[]
  recurringTransactions RecurringTransaction[]
  netWorthEntries       NetWorthEntry[]
  categoryBudgets       CategoryBudget[]
  ownedGroups           Group[]
  groupMemberships      GroupMember[]
  submittedExpenses     Expense[]              @relation("SubmittedExpenses")
  reviewedExpenses      Expense[]              @relation("ReviewedExpenses")
  salaries              Salary[]
  achievements          Achievement[]
  pushTokens            PushToken[]
  plaidItems            PlaidItem[]
  emailConnections      EmailConnection[]
  inboxEmails           InboxEmail[]
  customCategories      CustomCategory[]
  subscriptions         Subscription[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("AuthAccount")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model BankAccount {
  id                    String                 @id
  userId                String
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                  String
  type                  String // cash|checking|savings|credit|investment|other
  /// The balance before any transaction in the ledger. The one balance input.
  openingBalance        Float                  @default(0)
  /// Derived, never written by the app: a trigger keeps it equal to
  /// openingBalance + Σ Income − Σ Expense of this account's transactions,
  /// on every transaction insert, update and delete and on every write of
  /// openingBalance. The phone derives it the same way and never sends it.
  balance               Float                  @default(0)
  currency              String                 @default("USD")
  color                 String                 @default("#a855f7")
  icon                  String                 @default("wallet")
  isDefault             Boolean                @default(false)
  /// Opt-in: when set, this account is visible IN FULL to that group,
  /// regardless of the owner's shareLevel. This is how a couple share a
  /// joint account without the app inventing joint ownership.
  sharedWithGroupId     String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  clientUpdatedAt       DateTime               @default(now())
  /// Set by trigger (clock_timestamp()); see the sync note at the top.
  serverUpdatedAt       DateTime               @default(now())
  transactions          Transaction[]
  recurringTransactions RecurringTransaction[]
  sharedWithGroup       Group?                 @relation(fields: [sharedWithGroupId], references: [id], onDelete: SetNull)

  @@index([sharedWithGroupId])
  @@index([userId, serverUpdatedAt])
}

model Transaction {
  id              String       @id
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId       String?
  account         BankAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  amount          Float
  category        String // Food|Gym|Transport|Shopping|Subscriptions|Other
  type            String // Expense|Income
  isImpulse       Boolean      @default(false)
  note            String?
  dateISO         String // YYYY-MM-DD
  currency        String       @default("USD")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  clientUpdatedAt DateTime     @default(now())
  /// Set by trigger (clock_timestamp()); see the sync note at the top.
  serverUpdatedAt DateTime     @default(now())

  @@index([userId, dateISO])
  @@index([userId, serverUpdatedAt])
}

model UserSettings {
  id              String   @id
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthlyBudget   Float    @default(0)
  startingBalance Float    @default(0)
  hourlyValue     Float    @default(0)
  showTimeCost    Boolean  @default(false)
  currency        String   @default("USD")
  currencySymbol  String   @default("$")
  monthlyIncome   Float    @default(0)
  savingsGoal     Float    @default(0)
  spendingStyle   String   @default("moderate")
  primaryGoal     String   @default("track")
  /// UI language: "en" | "fr" | "zh". Synced so it follows the user's account
  /// across devices; the device language is only the first-run default.
  locale          String   @default("en")
  // Which business the user is currently acting in. Membership resolution used
  // findFirst, so a user in more than one business got a non-deterministic
  // answer that could change between requests.
  activeGroupId   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  clientUpdatedAt DateTime @default(now())
  /// Set by trigger (clock_timestamp()); see the sync note at the top.
  serverUpdatedAt DateTime @default(now())
}

model BillReminder {
  id              String    @id
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  amount          Float
  dueDay          Int // day of month (1-31)
  category        String    @default("Other")
  isRecurring     Boolean   @default(true)
  isPaid          Boolean   @default(false)
  paidAt          DateTime?
  nextDueDate     String // YYYY-MM-DD
  // Last push sent for the *current* nextDueDate. Guards the 5-minute checker
  // against re-notifying a bill that has already fired for this due date —
  // non-recurring bills never advance nextDueDate, so without this they match
  // the due query on every tick forever. Server-only: not on the sync wire. A
  // write that moves nextDueDate later re-arms it (sets it null).
  lastNotifiedAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  clientUpdatedAt DateTime  @default(now())
  /// Set by trigger (clock_timestamp()); see the sync note at the top.
  serverUpdatedAt DateTime  @default(now())

  @@index([userId, nextDueDate])
  @@index([userId, serverUpdatedAt])
}

model RecurringTransaction {
  id              String       @id
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Where occurrences are booked: always one of the owner's accounts, or
  /// null (then the owner's default account). Unlinked when it is deleted.
  accountId       String?
  account         BankAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  name            String
  amount          Float
  category        String
  type            String // Expense|Income
  isImpulse       Boolean      @default(false)
  frequency       String // daily|weekly|biweekly|monthly|yearly
  startDate       String // YYYY-MM-DD
  nextDate        String // YYYY-MM-DD
  lastCreated     String? // YYYY-MM-DD
  isActive        Boolean      @default(true)
  currency        String       @default("USD")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  clientUpdatedAt DateTime     @default(now())
  /// Set by trigger (clock_timestamp()); see the sync note at the top.
  serverUpdatedAt DateTime     @default(now())

  @@index([userId])
  @@index([isActive, nextDate])
  @@index([userId, serverUpdatedAt])
  @@index([accountId])
}

model NetWorthEntry {
  id              String   @id
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            String // YYYY-MM-DD
  assets          Float    @default(0)
  liabilities     Float    @default(0)
  netWorth        Float    @default(0)
  breakdown       String? // JSON string
  createdAt       DateTime @default(now())
  clientUpdatedAt DateTime @default(now())
  /// Set by trigger (clock_timestamp()); see the sync note at the top.
  serverUpdatedAt DateTime @default(now())

  @@index([userId, serverUpdatedAt])
}

// Synced by category (the phone's sync id), not by id: one budget per
// category per user.
model CategoryBudget {
  id              String   @id
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        String
  amount          Float
  period          String   @default("monthly")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  clientUpdatedAt DateTime @default(now())
  /// Set by trigger (clock_timestamp()); see the sync note at the top.
  serverUpdatedAt DateTime @default(now())

  @@unique([userId, category])
  @@index([userId, serverUpdatedAt])
}

// Persisted gamification: a badge stays earned even after the underlying
// transactions change or the app is reinstalled. `badge` is the badge key
// (e.g. "7-Day Streak"); `bestStreak` tracks the user's all-time logging streak.
model Achievement {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge      String
  earnedAt   DateTime @default(now())
  bestStreak Int      @default(0)

  @@unique([userId, badge])
}

// Expo push tokens for delivering bill reminders, streak nudges, and
// badge-earned alerts. One row per device; token is unique.
model PushToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A linked Plaid Item (one per institution connection). The access token is
// stored encrypted at rest (AES-256-GCM, key derived from BETTER_AUTH_SECRET).
// `cursor` is Plaid's /transactions/sync pagination cursor for incremental pulls.
// A linked bank connection. Named for Plaid because it was the first (and so
// far only) provider; the rows are provider-neutral storage — see
// lib/bank-providers for the abstraction and `provider` below.
model PlaidItem {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Which BankProvider owns this connection, so a second provider can coexist.
  provider        String         @default("plaid")
  itemId          String         @unique
  accessTokenEnc  String
  institutionId   String?
  institutionName String?
  cursor          String?
  status          String         @default("active") // active|error|disconnected
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  accounts        PlaidAccount[]
}

// An account exposed by a Plaid Item, mirrored locally for display + balances.
model PlaidAccount {
  id             String    @id @default(cuid())
  itemId         String
  item           PlaidItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  plaidAccountId String    @unique
  name           String
  type           String // checking|savings|credit|investment|other
  mask           String?
  balance        Float     @default(0)
  currency       String    @default("USD")
  isEnabled      Boolean   @default(true)
  // The local BankAccount this Plaid account is mirrored into. Bank-synced
  // transactions are booked against it, so they affect a balance and can be
  // filtered by account like any hand-entered row.
  bankAccountId  String?
  updatedAt      DateTime  @updatedAt
}

// One mailbox Latchet reads billing email from, for one user (Phase 6).
//
// `provider` is forwarding | gmail | outlook. `email` is the account's address,
// lower-case, for gmail and outlook; for forwarding it is the synthetic
// `forwarding:<userId>`, so the [userId, email] unique key stops two racing
// first requests from creating a second inbox. A user may connect several.
//
// Forwarding: `inboundToken` forms the private address
// u_<inboundToken>@<INBOUND_EMAIL_DOMAIN>; `forwardingVerified` flips true when
// the first real forwarded email arrives (Gmail's own confirmation email does
// not count — it is stored separately so the app can show its code).
//
// Gmail and Outlook: `refreshTokenEnc` is the OAuth refresh token, encrypted at
// rest (lib/crypto); `scope` what the user granted. `syncCursor` is the
// provider's incremental position (Gmail historyId, a Graph delta link) and
// `backfillCursor` the one-year backfill's page position until
// `backfillDoneAt`. `status` is active | needs_reauth | error and `syncState`
// idle | backfilling | syncing; `lastError` is a short code, never mail text.
// `messagesScanned` and `findingsCount` are counters for the connect screen.
//
// Deleting a connection deletes its findings (InboxEmail.connectionId cascades).
model EmailConnection {
  id                 String       @id @default(cuid())
  userId             String
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider           String       @default("forwarding") // forwarding | gmail | outlook
  email              String
  inboundToken       String?      @unique
  forwardingVerified Boolean      @default(false)
  refreshTokenEnc    String?
  scope              String?
  status             String       @default("active") // active | needs_reauth | error
  syncState          String       @default("idle") // idle | backfilling | syncing
  syncCursor         String?
  backfillCursor     String?
  backfillDoneAt     DateTime?
  lastSyncedAt       DateTime?
  /// A short error code (e.g. "invalid_grant"), never text from a message.
  lastError          String?
  messagesScanned    Int          @default(0)
  findingsCount      Int          @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  findings           InboxEmail[]

  @@unique([userId, email])
}

// That a user once granted Latchet access to a mailbox provider, kept for life.
//
// Google caps an unverified app at 100 users over its lifetime, counting every
// account that ever granted access, so our own counter must count the same
// way: a row here outlives the connection and the account. Deliberately no
// relation to User, so deleting the account leaves it; `userKey` is the
// sha256 of the user id, which identifies nobody once the account is gone.
model EmailOAuthGrant {
  id             String   @id @default(cuid())
  provider       String // gmail | outlook
  /// sha256 (hex) of the user id.
  userKey        String
  firstGrantedAt DateTime @default(now())

  @@unique([provider, userKey])
}

// One email finding from any source: a billing email (forwarded, or read from
// a connected Gmail or Outlook mailbox) reduced to what the subscription
// detector needs. The phone pulls these (by `receivedAt`, the insert time and
// the findings cursor) and runs detection on them alongside its ledger; a
// finding never becomes a transaction.
//
// The raw email is never stored: not the body, not the sender address, not the
// subject line. Receipt subjects routinely carry order numbers, invoice
// references and the amount itself, and keeping them indefinitely contradicted
// the privacy policy's promise to retain only merchant, amount, currency, cycle
// and date. `label` is a digit-stripped remnant kept solely so the inbox screen
// can show something for an email the parser failed to identify.
//
// `messageKey` (sha256 of `provider:messageId`) makes reading the same message
// twice — a re-sync, a retried webhook — store it once per user. `currency` is
// null when the email does not say: unknown stays unknown.
model InboxEmail {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId   String?
  connection     EmailConnection? @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  source         String           @default("forwarding") // forwarding | gmail | outlook
  messageKey     String?
  /// renewal | receipt | trial_ending | price_change | cancellation | other
  kind           String           @default("other")
  /// Sender's domain only (e.g. "netflix.com") — identifies the merchant, not the person.
  senderDomain   String?
  /// Sanitised subject remnant, no digits. May be empty.
  label          String           @default("")
  merchant       String?
  amount         Float?
  currency       String?
  /// weekly | biweekly | monthly | quarterly | semiannual | yearly | unknown
  cadence        String           @default("unknown")
  chargedISO     String? // YYYY-MM-DD best-effort charge date
  emailDateISO   String? // YYYY-MM-DD the email was sent
  nextChargeISO  String? // YYYY-MM-DD the next charge, when the email says
  trialEndsISO   String? // YYYY-MM-DD a free trial ends, when the email says
  previousAmount Float? // the old price, for a price-change email
  confidence     Float            @default(0)
  parser         String           @default("rules") // rules | ai
  billedVia      String? // apple | google_play | paypal: where the charge is billed
  isSubscription Boolean          @default(false)
  status         String           @default("parsed") // parsed | imported | ignored | confirmation
  receivedAt     DateTime         @default(now())

  @@unique([userId, messageKey])
  @@index([userId, receivedAt])
  @@index([connectionId])
}

model Group {
  id                   String        @id @default(cuid())
  ownerId              String
  name                 String
  /// "business" | "household". A household is the same shape with different
  /// labels and a different role vocabulary; see GroupMember.role.
  type                 String        @default("business")
  // Company profile and tax identity. All optional: a sole trader has no VAT
  // number, and nothing here should block using the app. Unused by households.
  //
  // logoUrl is a path this backend serves, never an arbitrary URL — a stored
  // remote address would be fetched by every client that renders the company.
  logoUrl              String?
  address              String?
  vatNumber            String?
  taxId                String?
  // Month the fiscal year starts, 1-12. Not a date: only the month matters,
  // and storing a full date invites timezone questions that have no answer.
  fiscalYearStartMonth Int?
  inviteCode           String?       @unique
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  owner                User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members              GroupMember[]
  expenses             Expense[]
  budget               GroupBudget?
  salaries             Salary[]
  sharedAccounts       BankAccount[]

  // One business AND one household per owner, not one group in total. The
  // old `ownerId @unique` predates households and would have made a
  // small-business owner choose between the two.
  @@unique([ownerId, type])
}

model GroupMember {
  id         String   @id @default(cuid())
  groupId    String
  userId     String
  /// business:  "owner" | "manager" | "employee"
  /// household: "owner" | "member"
  role       String
  /// "summary" | "categories" | "full" — what THIS member reveals about
  /// themselves to the rest of the group. Self-chosen, never set by anyone
  /// else, and enforced server-side in lib/share-level.ts. Defaults to the
  /// least revealing value so a missing choice cannot over-share.
  shareLevel String   @default("summary")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model Expense {
  id          String    @id @default(cuid())
  groupId     String
  submitterId String
  reviewerId  String?
  amount      Float
  category    String // Travel|Software|Meals|Transport|Office|Other
  description String
  imageUrl    String?
  status      String    @default("pending") // pending|approved|rejected
  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  group       Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  submitter   User      @relation("SubmittedExpenses", fields: [submitterId], references: [id], onDelete: Cascade)
  reviewer    User?     @relation("ReviewedExpenses", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([groupId, status])
  @@index([groupId, submittedAt])
}

model GroupBudget {
  id           String   @id @default(cuid())
  groupId      String   @unique
  totalMonthly Float    @default(0)
  categories   String? // JSON: { "Travel": 500, "Meals": 200, ... }
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  group        Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model Salary {
  id        String          @id @default(cuid())
  groupId   String
  userId    String
  amount    Float // monthly salary amount
  currency  String          @default("USD")
  title     String? // job title / role label
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  group     Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments  SalaryPayment[]

  @@unique([groupId, userId])
  @@index([groupId])
}

model SalaryPayment {
  id        String    @id @default(cuid())
  salaryId  String
  month     Int // 1–12
  year      Int
  status    String    @default("unpaid") // "paid" | "unpaid"
  paidAt    DateTime?
  note      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  salary    Salary    @relation(fields: [salaryId], references: [id], onDelete: Cascade)

  @@unique([salaryId, month, year])
}

// ─── Synced from the phone ───────────────────────────────────────────────────

// A category the user added on top of the built-in ones. The sync id is the
// name: the phone keys custom categories by name, so two devices that both add
// "Pets" converge on one row instead of two.
model CustomCategory {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  icon            String   @default("")
  color           String   @default("#94a3b8")
  createdAt       DateTime @default(now())
  clientUpdatedAt DateTime @default(now())
  /// Set by trigger (clock_timestamp()); see the sync note at the top.
  serverUpdatedAt DateTime @default(now())

  @@unique([userId, name])
  @@index([userId, serverUpdatedAt])
}

// A recurring charge found on the phone, from any source: the ledger it
// keeps (hand entry, statement imports, bank transactions arriving by sync) or
// a billing email (InboxEmail). `syncId` is the phone's own id for it; `id` is
// this table's key. Occurrences are derived on the device and are not stored.
//
// Two kinds of state live side by side, and the user's always wins (Phase 6
// decision 3):
//   decision  the user's: keep | cancel | dismiss, or null while they have not
//             said. Detection never writes it, never revives a dismissed row
//             and never resets a cancellation; deleting a subscription in the
//             app is a dismissal, so a later import cannot recreate it.
//   status    the engine's reading — possible | active | trial | ended — while
//             there is no decision; once there is one it follows it: keep →
//             confirmed, cancel → canceled, dismiss → dismissed.
// A push from a phone older than Phase 6 carries no decision: it keeps the
// stored one, and its own confirmed/canceled status becomes the decision only
// where none was made yet, as the Phase 6 migration read them
// (lib/sync/subscription-fields.ts).
//
// The engine's other findings: `trialEndsAt` (a free trial converts that day),
// `previousAmount` and `priceChangedAt` (the last price rise), `alert` (what
// to warn about: price_rise | charged_after_cancel | trial_ending), `sources`
// (every source that saw it, a comma list of transaction | import | bank |
// email | manual; `source` is the first one) and `billedVia` (apple |
// google_play | paypal: where it must be cancelled). Dates are YYYY-MM-DD.
model Subscription {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncId             String
  merchantDisplay    String
  merchantNormalized String
  /// weekly | biweekly | monthly | quarterly | semiannual | yearly | unknown
  cadence            String   @default("monthly")
  typicalAmount      Float    @default(0)
  currency           String   @default("USD")
  confidenceScore    Float    @default(0)
  lastChargedAt      String?
  nextExpectedAt     String?
  /// possible | active | trial | ended (the engine's), or confirmed | canceled | dismissed (following `decision`)
  status             String   @default("possible")
  /// keep | cancel | dismiss: the user's, never the engine's.
  decision           String?
  /// YYYY-MM-DD the user cancelled it.
  canceledAt         String?
  trialEndsAt        String?
  previousAmount     Float?
  priceChangedAt     String?
  /// price_rise | charged_after_cancel | trial_ending
  alert              String?
  cancelUrl          String?
  cancelNotes        String?
  source             String   @default("transaction") // transaction | import | bank | email | manual
  /// Comma list of every source that saw it.
  sources            String   @default("")
  /// apple | google_play | paypal
  billedVia          String?
  createdAt          DateTime @default(now())
  clientUpdatedAt    DateTime @default(now())
  /// Set by trigger (clock_timestamp()); see the sync note at the top.
  serverUpdatedAt    DateTime @default(now())

  @@unique([userId, syncId])
  @@index([userId, serverUpdatedAt])
}

// One deleted synced row, so a pull can tell other devices it is gone.
//
// Written by an AFTER DELETE trigger on each synced table, which catches every
// delete path (REST, sync push, cascades, bank unlink) without each route
// remembering to. entity: transactions|accounts|settings|categories|
// subscriptions|recurring|billReminders|categoryBudgets|netWorth. syncId is
// the row's sync id: `id` for transactions, accounts, recurring series, bill
// reminders and net-worth snapshots, "settings" for the settings row, `name`
// for a category, `category` for a category budget, `syncId` for a
// subscription. A category budget moved to another category also leaves one
// for its old category (an AFTER UPDATE trigger).
//
// Deliberately no relation to User: deleting a user cascades into the synced
// tables, whose triggers then write here, and a foreign key back to the user
// being deleted would fail inside its own cascade. Retention purges orphans.
model SyncTombstone {
  id              String   @id @default(cuid())
  userId          String
  entity          String
  syncId          String
  /// Database time of the delete (clock_timestamp(), UTC). The pull cursor
  /// orders by it, as it does by serverUpdatedAt for live rows.
  deletedAt       DateTime @default(now())
  /// The delete's client time. An upsert newer than this resurrects the row.
  clientUpdatedAt DateTime @default(now())

  @@unique([userId, entity, syncId])
  @@index([userId, deletedAt])
}

// ─── Process-local state, moved into the database ───────────────────────────
// Several instances can serve the API at once, so nothing that must agree
// across requests may live in one process's memory.

// A fixed-window counter: rate limits and usage caps.
model RateLimitBucket {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
  expiresAt   DateTime

  @@index([expiresAt])
}

// Short-lived shared state: caches and one-time values with an expiry.
model CacheEntry {
  key       String   @id
  value     Json
  expiresAt DateTime

  @@index([expiresAt])
}

// An uploaded file (receipt image, company logo), stored in the database so
// every instance can serve it and no volume is needed.
model StoredFile {
  id          String   @id @default(cuid())
  kind        String
  ownerId     String?
  contentType String
  size        Int
  bytes       Bytes
  createdAt   DateTime @default(now())

  @@index([kind, ownerId])
}

// Which instance runs a periodic job right now, and until when.
model JobLease {
  name       String   @id
  holder     String
  leaseUntil DateTime
}
