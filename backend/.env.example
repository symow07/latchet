# Copy to .env and fill in. Only the first two are required to boot.

# ── Required ────────────────────────────────────────────────────────────────
# Signs sessions. 32 chars minimum. Safe to rotate once TOKEN_ENCRYPTION_KEY is
# set below — rotating it then costs only a forced re-login.
BETTER_AUTH_SECRET=
# In production point this at a persistent volume, e.g. file:/data/prod.db
DATABASE_URL="file:./prisma/dev.db"

# ── Strongly recommended ────────────────────────────────────────────────────
# Encrypts Plaid access tokens at rest. 32 chars
# minimum. Generate with: openssl rand -base64 48
#
# Without it the encryption key is derived from BETTER_AUTH_SECRET, which means
# that secret can never be rotated — changing it would make every stored token
# undecryptable and force every user to relink. Set this before launch.
# NOT safe to rotate afterwards without re-encrypting stored tokens.
TOKEN_ENCRYPTION_KEY=

# Public HTTPS URL of this backend. Used for provider webhooks.
BACKEND_URL="http://localhost:3000"
PORT=3000
# NODE_ENV=production disables /api/debug and verbose logging.
# NODE_ENV=production

# ── Outgoing email ──────────────────────────────────────────────────────────
# Not needed for sign-in (email + password). Used for outgoing mail such as
# password reset and verification. In non-production, with neither set,
# outgoing mail is logged to the console.
RESEND_API_KEY=
EMAIL_FROM="Budget <noreply@yourdomain.com>"
# Or point at your own relay instead of Resend:
# SMTP_SERVICE_URL=

# ── Optional features (each returns 503 until configured) ───────────────────
# AI advisor, receipt scan, PDF statement import, email parsing
OPENAI_API_KEY=

# Bank linking. PLAID_ENV=production needs Plaid production approval.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Countries this Plaid account is enabled for. The link flow narrows this by the
# user's own currency; requesting a country you are not enabled for is an error.
PLAID_COUNTRY_CODES=US

# Forward-to-inbox subscription detection
INBOUND_EMAIL_DOMAIN=
INBOUND_EMAIL_SECRET=

# ── Overrides ───────────────────────────────────────────────────────────────
# Exchange-rate provider. Default needs no key and covers 160+ currencies.
# EXCHANGE_RATES_URL="https://open.er-api.com/v6/latest/USD"
# Comma-separated production origins trusted for auth cookies / CORS.
# TRUSTED_ORIGINS=
# CORS_ORIGINS=
