# Copy to .env and fill in. Only the first two are required to boot.

# ── Required ────────────────────────────────────────────────────────────────
# Signs sessions. 32 chars minimum. Safe to rotate once TOKEN_ENCRYPTION_KEY is
# set below — rotating it then costs only a forced re-login.
BETTER_AUTH_SECRET=
# Postgres. Locally: `createdb budget_dev` once, then `bunx prisma migrate deploy`.
# ${USER} is expanded by both Bun and the Prisma CLI; the user must be named,
# because Prisma (unlike psql) does not default it to your login. Required in
# production, where it is the Railway Postgres service's connection URL.
DATABASE_URL="postgresql://${USER}@localhost:5432/budget_dev"

# ── Strongly recommended ────────────────────────────────────────────────────
# Encrypts Plaid access tokens at rest. 32 chars
# minimum. Generate with: openssl rand -base64 48
#
# Without it the encryption key is derived from BETTER_AUTH_SECRET, which means
# that secret can never be rotated — changing it would make every stored token
# undecryptable and force every user to relink. Set this before launch.
# NOT safe to rotate afterwards without re-encrypting stored tokens.
TOKEN_ENCRYPTION_KEY=

# Public HTTPS URL of this backend. Used for provider webhooks.
BACKEND_URL="http://localhost:3000"
PORT=3000
# NODE_ENV=production disables /api/debug and verbose logging.
# NODE_ENV=production

# ── Outgoing email ──────────────────────────────────────────────────────────
# Password-reset links and email-verification links (sent at sign-up and from
# Settings). Sign-in itself never needs mail. Set one of the two in production:
# without a provider, sign-up and reset requests still succeed and answer
# exactly as before, but no mail goes out — each attempt is logged as
# "[auth-mail] … failed" — so nobody can reset a password.
# In non-production, with neither set, mail is logged to the console with its
# plain-text body: open the link from the log to follow a reset locally.
# Mail to reserved domains (example.com, *.test, …) is never sent anywhere.
RESEND_API_KEY=
# Must be on a domain verified in Resend; Resend's own onboarding@resend.dev
# (the default when unset) only delivers to the Resend account's own address.
EMAIL_FROM="Budget <noreply@yourdomain.com>"
# Or point at your own relay instead of Resend:
# SMTP_SERVICE_URL=

# ── Optional features (each returns 503 until configured) ───────────────────
# AI advisor, receipt scan, PDF statement import. Email parsing works without
# it (rules first); with it, AI reads the emails the rules cannot.
OPENAI_API_KEY=

# Bank linking. Sandbox is free; PLAID_ENV=production needs Plaid's approval.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Countries this Plaid account is enabled for. The link flow narrows this by the
# user's own currency; requesting a country you are not enabled for is an error.
PLAID_COUNTRY_CODES=US,CA,GB,FR,ES,IE,NL,DE,IT,BE,PT
# Development only: everyone counts as Pro, so bank linking can be tried
# without a purchase. Ignored in production.
# DEV_PRO_OVERRIDE=true

# Inbox reading. Redirect URI to register with each provider:
#   ${BACKEND_URL}/api/v1/email/oauth/gmail/callback
#   ${BACKEND_URL}/api/v1/email/oauth/outlook/callback
# Gmail (Google Cloud OAuth client, "Web application"; scope gmail.readonly).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# true only once Google has verified the app; lifts the 100-user cap below.
# GOOGLE_OAUTH_VERIFIED=false
# GMAIL_USER_CAP=100
# Outlook (Microsoft Entra app registration, personal accounts; Mail.Read).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=consumers
# EMAIL_SYNC_INTERVAL_MINUTES=60

# Forward-to-inbox, the backup for providers with no inbox API (iCloud, Yahoo, GMX)
INBOUND_EMAIL_DOMAIN=
INBOUND_EMAIL_SECRET=

# ── Overrides ───────────────────────────────────────────────────────────────
# Exchange-rate provider. Default needs no key and covers 160+ currencies.
# EXCHANGE_RATES_URL="https://open.er-api.com/v6/latest/USD"
# Comma-separated production origins trusted for auth cookies / CORS.
# TRUSTED_ORIGINS=
# CORS_ORIGINS=
